{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dockz",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "landing",
    // Unknown paths answer 404 with landing/404.html instead of the home
    // page with 200 (search engines treat that as duplicate "soft 404"s).
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
